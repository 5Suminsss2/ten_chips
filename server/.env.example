# server/.env.example — 복사해서 server/.env 로 쓰세요 (server/.env 는 git 에 안 올라감)

# 관리자 로그인 비밀번호 — 배포에선 반드시 바꾸고 secret 으로 주입
ADMIN_PASSWORD=change-me

# YouTube Data API v3 키 — 없으면 검색 비활성 (수동 링크/ID 입력만)
YOUTUBE_API_KEY=

# 세션 유효기간(일)
SESSION_TTL_DAYS=7

# HTTPS 프로덕션에서만 true (dev 는 false)
COOKIE_SECURE=false

# DB 접속 URL — 기본은 server/ 아래 sqlite 파일
# Postgres 예: postgresql+psycopg://user:pass@host:5432/tentracks
DATABASE_URL=sqlite:///./tentracks.db

# CORS 허용 오리진 (쉼표 구분). dev 에서 vite 프록시를 쓰면 비워둬도 됨.
# 예: https://tentracks.example.com
CORS_ORIGINS=

# 로그인 실패 rate-limit (IP 기준, 인메모리)
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# 프록시(로드밸런서) 뒤에 있으면 true — X-Forwarded-For 의 첫 IP 를 클라이언트로 본다
TRUST_PROXY=false
